{
    "name": "aashro/at-villa",
    "type": "typo3-cms-extension",
    "description": "AT Villa – Real Estate Property Website",
    "authors": [
        {
            "name": "Aashro Tech",
            "email": "info@aashro.com",
            "role": "Developer",
            "homepage": "https://www.aashro.com/"
        }
    ],
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^13",
        "friendsoftypo3/content-blocks": "^1.0.0",
        "georgringer/news": "^14.0.1"
    },
    "autoload": {
        "psr-4": {
            "Aashro\\AtVilla\\": "Classes"
        }
    },
    "replace": {
        "typo3-ter/at-villa": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "extension-key": "at_villa"
        }
    }
}